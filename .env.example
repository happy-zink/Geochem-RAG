# Copy to .env (gitignored) and fill in your own key. Never commit a real key.
# The code reads these from the environment; .env is only a convenience to
# export them (see README / scripts for the sourcing command).

# Required for free embedding API: SiliconFlow API key.
SILICONFLOW_API_KEY=

# Required for strong answer generation: official DeepSeek API key.
DEEPSEEK_API_KEY=

# Chat and embedding providers are configured independently.
GEOCHEM_CHAT_PROVIDER=deepseek
GEOCHEM_EMBEDDING_PROVIDER=siliconflow
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# SiliconFlow embedding endpoint.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# BGE-M3 was available on 2026-09-28. Before indexing a large corpus,
# confirm its current free billing status in your SiliconFlow account.
GEOCHEM_EMBEDDING_MODEL=BAAI/bge-m3

# Only used when GEOCHEM_CHAT_PROVIDER=siliconflow.
GEOCHEM_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional transport tuning.
GEOCHEM_API_TIMEOUT=60
GEOCHEM_API_MAX_RETRIES=2
GEOCHEM_API_BACKOFF=1.5
# Set to 1 to ignore system HTTP(S) proxies (useful when a local proxy is
# unreachable). Default 0 keeps urllib's normal proxy discovery.
GEOCHEM_DISABLE_PROXY=0
